---
// 여행 커넥트 허브 (2026-09-10). 상품 수가 적어 표 한 장으로 전부 비교시킨다.
//   AI 인용은 상단 30%에서 44%가 나온다 → 요약 문단과 비교 표를 가장 위에 둔다.
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_URL, getTravel } from '../../lib/site';
import { AUTHOR_NODE, ORGANIZATION } from '../../consts';

const trips = await getTravel();
// 서브도메인 빌드에는 여행 섹션이 없다.
if (trips.length === 0) return Astro.redirect('/', 301);

const won = (n: number) => n.toLocaleString('ko-KR') + '원';
const STATUS_LABEL: Record<string, string> = {
	available: '예약 가능', confirmed: '출발 확정', urgent: '긴급 모객', sold_out: '판매 종료',
};
const prices = trips.map((t) => t.data.salePrice ?? t.data.price).sort((a, b) => a - b);
const checked = trips.map((t) => t.data.priceCheckedAt).sort().at(-1)!;
const title = `해외 패키지여행 ${trips.length}선 가격·출발일 비교`;
const description = `네이버 티켓·패키지에서 판매 중인 해외 패키지 ${trips.length}개를 1인 요금과 출발일 기준으로 정리했다. ${won(prices[0])}부터 ${won(prices.at(-1)!)}까지.`;
const summary = `이 페이지는 네이버 티켓·패키지에서 파는 해외 패키지여행 ${trips.length}개를 한 표로 비교한 목록이다. 1인 요금은 ${won(prices[0])}부터 ${won(prices.at(-1)!)}까지 분포하고, 몽골 4박5일과 태국 허니문처럼 150만원대인 상품부터 스코틀랜드 골프 8박10일처럼 3천만원대인 상품까지 가격대가 넓다. 각 상품은 출발일이 하나로 고정된 확정 출발 상품이라 날짜를 고를 수 없고, 좌석이 소진되면 판매가 닫힌다. 표에는 여행사, 항공사, 일정 길이, 판매 상태를 함께 적었고 상품별 상세 페이지에서 포함 사항과 자주 묻는 질문을 볼 수 있다. 가격은 ${checked} 기준이며 판매처에서 수시로 바뀐다.`;
const url = `${SITE_URL}/travel/`;

const ld = [
	{
		'@context': 'https://schema.org', '@type': 'CollectionPage',
		name: title, description, url, abstract: summary,
		author: AUTHOR_NODE, publisher: ORGANIZATION,
	},
	{
		'@context': 'https://schema.org', '@type': 'ItemList',
		name: title,
		itemListElement: trips.map((t, i) => ({
			'@type': 'ListItem', position: i + 1,
			item: {
				'@type': 'TouristTrip',
				name: t.data.productName,
				url: `${SITE_URL}/travel/${t.id}/`,
				touristType: t.data.destination,
				provider: { '@type': 'Organization', name: t.data.agency },
				offers: { '@type': 'Offer', price: t.data.salePrice ?? t.data.price, priceCurrency: 'KRW', url: t.data.affiliateUrl },
			},
		})),
	},
	{
		'@context': 'https://schema.org', '@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: '홈', item: `${SITE_URL}/` },
			{ '@type': 'ListItem', position: 2, name: '여행 패키지', item: url },
		],
	},
];
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={title} description={description} />
		{ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
		<style>
			main { max-width: 900px; margin: 0 auto; }
			h1 { font-size: 1.6em; margin: 0 0 .4em; }
			.summary { line-height: 1.75; background: rgb(var(--gray-light)); padding: 1em 1.1em; border-radius: 10px; margin: 0 0 1.4em; }
			.disclosure { font-size: .85em; color: rgb(var(--gray)); border-left: 3px solid rgb(var(--gray-light)); padding: .4em .8em; margin: 0 0 1.4em; }
			table { width: 100%; display: block; overflow-x: auto; border-collapse: collapse; font-size: .93em; }
			th, td { border: 1px solid rgb(var(--gray-light)); padding: .5em .6em; text-align: left; white-space: nowrap; }
			th { background: rgb(var(--gray-light)); }
			td.name { white-space: normal; min-width: 15em; }
			td.name a { font-weight: 600; }
			.note { font-size: .85em; color: rgb(var(--gray)); margin-top: 1.4em; line-height: 1.7; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>{title}</h1>
			<p class="disclosure">이 페이지의 링크는 네이버 여행 커넥트 제휴 링크이며, 예약이 발생하면 일정 수수료를 받습니다.</p>
			<p class="summary">{summary}</p>
			<table>
				<thead>
					<tr><th>상품</th><th>1인 요금</th><th>출발일</th><th>일정</th><th>여행사</th><th>상태</th></tr>
				</thead>
				<tbody>
					{trips.map((t) => (
						<tr>
							<td class="name"><a href={`/travel/${t.id}/`}>{t.data.title}</a></td>
							<td>{won(t.data.salePrice ?? t.data.price)}</td>
							<td>{t.data.departureDate}</td>
							<td>{t.data.nights}</td>
							<td>{t.data.agency}</td>
							<td>{STATUS_LABEL[t.data.status]}</td>
						</tr>
					))}
				</tbody>
			</table>
			<p class="note">
				가격과 판매 상태는 {checked} 기준으로 네이버 티켓·패키지 판매 페이지에서 확인한 값이다.
				확정 출발 상품은 좌석이 소진되면 예고 없이 판매가 닫히므로 예약 전 판매처에서 잔여석을 다시 확인해야 한다.
			</p>
		</main>
		<Footer />
	</body>
</html>
