---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { topicHubs } from '../../lib/categories';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return topicHubs(posts, 15).map((h) => ({
		params: { topic: h.slug },
		props: { sub: h.sub, count: h.count, posts: h.posts },
	}));
}

const { sub, count, posts } = Astro.props;
const fmtPrice = (n?: number) => (n && n > 0 ? n.toLocaleString('ko-KR') + '원' : '');

// 비교 허브의 존재 이유는 "이 카테고리의 가격대가 어느 정도인가"에 답하는 것이다.
//   프론트매터의 실제 가격만 쓴다(추정·보정 없음). 가격 없는 글은 통계에서 제외.
const priced = posts.filter((p: any) => p.data.productPrice > 0);
const prices = priced.map((p: any) => p.data.productPrice).sort((a: number, b: number) => a - b);
const median = prices.length ? prices[Math.floor(prices.length / 2)] : 0;
const stores = new Set(posts.map((p: any) => p.data.productStore).filter(Boolean));

// 비교 페이지이므로 가격 오름차순이 기본 정렬이다(원래는 최신순).
//   가격 없는 글은 뒤로 보내 목록에서 빠지지 않게 한다.
const sorted = [...posts].sort((a: any, b: any) => {
	const pa = a.data.productPrice > 0 ? a.data.productPrice : Infinity;
	const pb = b.data.productPrice > 0 ? b.data.productPrice : Infinity;
	if (pa !== pb) return pa - pb;
	return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
});

const title = `${sub} 추천 ${count}선 가격 비교${prices.length ? ` (${fmtPrice(prices[0])}~${fmtPrice(prices[prices.length - 1])})` : ''} | ${SITE_TITLE}`;
const description = prices.length
	? `${sub} 상품 ${count}개를 가격순으로 비교했습니다. 최저 ${fmtPrice(prices[0])}, 중간값 ${fmtPrice(median)}, 최고 ${fmtPrice(prices[prices.length - 1])}. 판매처 ${stores.size}곳.`
	: `${sub} 상품 ${count}개를 한 곳에 모아 비교했습니다.`;

// ItemList 구조화 데이터 — 허브가 목록 페이지임을 명시해 리치결과·AI 인용 대상이 되게 한다.
//   가격은 실제 값만, 리뷰·평점은 직접 리뷰가 아니므로 넣지 않는다(BlogPost의 정책과 동일).
const itemListLd = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: `${sub} 추천 ${count}선`,
	numberOfItems: count,
	itemListElement: sorted.slice(0, 30).map((p: any, i: number) => ({
		'@type': 'ListItem',
		position: i + 1,
		name: p.data.productName || p.data.title,
		url: new URL(`/blog/${p.id}/`, Astro.site).href,
	})),
};
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={title} description={description} />
		<script type="application/ld+json" set:html={JSON.stringify(itemListLd)} />
		<style>
			.hub-head { margin-bottom: 0.5rem; }
			.hub-head h1 { margin: 0 0 0.4rem; }
			.hub-head p { color: rgb(var(--gray)); margin: 0; }
			.crumb { font-size: 0.85rem; margin-bottom: 1rem; }
			.crumb a { color: rgb(var(--gray)); }
			.pricebar { display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; margin: 1rem 0 0; padding: 0.9rem 1.1rem; border: 1px solid rgb(var(--gray-light)); border-radius: 10px; background: #fafafb; }
			.pricebar div { display: flex; flex-direction: column; gap: 0.15rem; }
			.pricebar dt { font-size: 0.78rem; color: rgb(var(--gray)); margin: 0; }
			.pricebar dd { margin: 0; font-weight: 700; font-size: 1rem; color: rgb(var(--black)); }
			ul.cards { list-style: none; margin: 1.4rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1.1rem; }
			ul.cards li { border: 1px solid rgb(var(--gray-light)); border-radius: 12px; overflow: hidden; display: flex; flex-direction: column; background: #fff; }
			.thumb { aspect-ratio: 1/1; background: #f4f4f6; overflow: hidden; }
			.thumb img { width: 100%; height: 100%; object-fit: cover; }
			.body { padding: 0.7rem 0.85rem 0.9rem; display: flex; flex-direction: column; gap: 0.35rem; flex: 1; }
			.body .name { font-size: 0.92rem; line-height: 1.35; color: rgb(var(--black)); text-decoration: none; flex: 1; }
			.body .name:hover { color: rgb(var(--accent)); }
			.price { font-weight: 700; color: rgb(var(--black)); font-size: 0.95rem; }
			a.buy { display: block; text-align: center; padding: 0.5rem 0; border-radius: 8px; background: rgb(var(--accent)); color: #fff; text-decoration: none; font-size: 0.88rem; margin-top: 0.2rem; }
			a.buy:hover { opacity: 0.88; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="crumb"><a href="/category/">카테고리</a> › <span>{sub}</span></div>
			<div class="hub-head">
				<h1>{sub} 추천 모음 <span style="color:rgb(var(--gray))">{count}선</span></h1>
				<p>{sub} 상품을 <strong>가격 낮은 순</strong>으로 정리했습니다. 상품명을 누르면 상세 글로, 최저가 버튼은 판매처로 이동합니다.</p>
			</div>
			{prices.length > 0 && (
				<dl class="pricebar">
					<div><dt>최저가</dt><dd>{fmtPrice(prices[0])}</dd></div>
					<div><dt>중간값</dt><dd>{fmtPrice(median)}</dd></div>
					<div><dt>최고가</dt><dd>{fmtPrice(prices[prices.length - 1])}</dd></div>
					<div><dt>판매처</dt><dd>{stores.size}곳</dd></div>
				</dl>
			)}
			<ul class="cards">
				{
					sorted.map((post: any) => (
						<li>
							<a href={`/blog/${post.id}/`} aria-label={post.data.productName || post.data.title}>
								<div class="thumb">
									{post.data.heroImage && <img src={post.data.heroImage} alt={post.data.productName || post.data.title} loading="lazy" />}
								</div>
							</a>
							<div class="body">
								<a class="name" href={`/blog/${post.id}/`}>{post.data.productName || post.data.title}</a>
								{fmtPrice(post.data.productPrice) && <span class="price">{fmtPrice(post.data.productPrice)}</span>}
								{post.data.productId && post.data.affiliateUrl && (
									<a class="buy" href={`/go/${encodeURIComponent(post.data.productId)}?u=${encodeURIComponent(post.data.affiliateUrl)}`} rel="nofollow sponsored noopener" target="_blank">
										최저가 보기
									</a>
								)}
							</div>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
