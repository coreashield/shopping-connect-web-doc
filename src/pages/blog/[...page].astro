---
import { Image } from 'astro:assets';
import { getPosts } from '../../lib/site';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

// 글 3,698개를 한 페이지에 전부 뿌리면 링크 신호가 희석되고 크롤 예산이 낭비된다.
// paginate로 쪼갠다. [...page] 라우트라 1페이지는 기존 URL(/blog/)이 그대로 유지된다.
export async function getStaticPaths({ paginate }: { paginate: any }) {
	const posts = (await getPosts()).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
	return paginate(posts, { pageSize: 24 });
}

const { page } = Astro.props;

// 2026-09-10 네이버 실측: /blog/ 가 30일 노출 11,577회에 클릭 3회(CTR 0.03%)였다.
//   제목이 사이트명뿐이라 검색결과에서 무엇을 주는 페이지인지 안 보였고 H1 도 없었다.
//   ① 1페이지는 개수·정렬·내용을 제목과 설명에 명시한다.
//   ② 2페이지 이후는 검색 가치가 없으므로 noindex(follow 유지)로 노출에서 뺀다.
const total = page.total;
const isFirst = page.currentPage === 1;
const pageTitle = isFirst
	? `상품 추천 글 ${total.toLocaleString('ko-KR')}개 최신순 — 가격·후기 비교 | ${SITE_TITLE}`
	: `${SITE_TITLE} 전체 글 ${page.currentPage}페이지`;
const pageDesc = isFirst
	? `${SITE_TITLE}가 정리한 상품 추천 글 ${total.toLocaleString('ko-KR')}개를 최신순으로 모았습니다. 각 글에 판매처 가격과 후기 수, 주요 스펙, 추천 대상이 들어 있습니다. 카테고리와 가격 비교 허브로도 찾아보세요.`
	: `${SITE_DESCRIPTION} (${page.currentPage}/${page.lastPage} 페이지)`;
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={pageTitle} description={pageDesc} noindex={!isFirst} />
		{page.url.prev && <link rel="prev" href={page.url.prev} />}
		{page.url.next && <link rel="next" href={page.url.next} />}
		<style>
			main {
				width: 960px;
			}
			.list-head {
				font-size: 1.6em;
				margin: 0 0 .3em;
			}
			.list-lead {
				color: rgb(var(--gray));
				line-height: 1.7;
				margin: 0 0 1.6em;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li:first-child img {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 2.369rem;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.563em;
				}
			}
			.pager {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 1.5rem;
				margin: 2.5rem 0 1rem;
				font-size: 0.95rem;
			}
			.pager a {
				text-decoration: none;
			}
			.pager .off {
				color: rgb(var(--gray));
				opacity: 0.5;
			}
			.pager .pos {
				color: rgb(var(--gray));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<h1 class="list-head">
					{isFirst ? `상품 추천 글 ${total.toLocaleString('ko-KR')}개` : `전체 글 ${page.currentPage}페이지`}
				</h1>
				{isFirst && (
					<p class="list-lead">
						판매처 가격과 후기 수, 주요 스펙을 정리한 상품 글을 최신순으로 보여줍니다.
						주제별로 찾으려면 <a href="/category/">카테고리</a>를, 가격대를 비교하려면 각 주제의 가격 비교 허브를 보세요.
					</p>
				)}
				<ul>
					{
						page.data.map((post: any) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<Image width={720} height={360} src={post.data.heroImage} alt="" />
									)}
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
				{/* 크롤러가 페이지를 순회할 수 있도록 실제 <a> 링크로 노출 */}
				<nav class="pager" aria-label="페이지 이동">
					{page.url.prev ? <a href={page.url.prev}>← 이전</a> : <span class="off">← 이전</span>}
					<span class="pos">{page.currentPage} / {page.lastPage}</span>
					{page.url.next ? <a href={page.url.next}>다음 →</a> : <span class="off">다음 →</span>}
				</nav>
			</section>
		</main>
		<Footer />
	</body>
</html>
