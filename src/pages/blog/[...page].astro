---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

// 글 3,698개를 한 페이지에 전부 뿌리면 링크 신호가 희석되고 크롤 예산이 낭비된다.
// paginate로 쪼갠다. [...page] 라우트라 1페이지는 기존 URL(/blog/)이 그대로 유지된다.
export async function getStaticPaths({ paginate }: { paginate: any }) {
	const posts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
	return paginate(posts, { pageSize: 24 });
}

const { page } = Astro.props;
const pageTitle = page.currentPage === 1 ? SITE_TITLE : `${SITE_TITLE} — ${page.currentPage}페이지`;
const pageDesc = page.currentPage === 1
	? SITE_DESCRIPTION
	: `${SITE_DESCRIPTION} (${page.currentPage}/${page.lastPage} 페이지)`;
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={pageTitle} description={pageDesc} />
		{page.url.prev && <link rel="prev" href={page.url.prev} />}
		{page.url.next && <link rel="next" href={page.url.next} />}
		<style>
			main {
				width: 960px;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li:first-child img {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 2.369rem;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.563em;
				}
			}
			.pager {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 1.5rem;
				margin: 2.5rem 0 1rem;
				font-size: 0.95rem;
			}
			.pager a {
				text-decoration: none;
			}
			.pager .off {
				color: rgb(var(--gray));
				opacity: 0.5;
			}
			.pager .pos {
				color: rgb(var(--gray));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul>
					{
						page.data.map((post: any) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<Image width={720} height={360} src={post.data.heroImage} alt="" />
									)}
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
				{/* 크롤러가 페이지를 순회할 수 있도록 실제 <a> 링크로 노출 */}
				<nav class="pager" aria-label="페이지 이동">
					{page.url.prev ? <a href={page.url.prev}>← 이전</a> : <span class="off">← 이전</span>}
					<span class="pos">{page.currentPage} / {page.lastPage}</span>
					{page.url.next ? <a href={page.url.next}>다음 →</a> : <span class="off">다음 →</span>}
				</nav>
			</section>
		</main>
		<Footer />
	</body>
</html>
