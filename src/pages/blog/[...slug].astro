---
import { type CollectionEntry, render } from 'astro:content';
import { getPosts, getGuides } from '../../lib/site';
import BlogPost from '../../layouts/BlogPost.astro';
import { topCategory, subPath, hubForPost } from '../../lib/categories';
import { compareForPost } from '../../lib/compare';
import { extractFaq } from '../../lib/faq';
import { isGoogleIndexable } from '../../lib/google-index';
import { comparePrimary } from '../../lib/canonical';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content, headings } = await render(post);

// 관련 글 (토픽 클러스터 — 2026 SEO: 같은 2단계 분류(진짜 같은 주제) 우선 → 같은 대분류 → 나머지).
//   같은 주제 글끼리 촘촘히 링크해야 구글이 클러스터로 인식하고 색인·랭킹이 붙는다.
const posts = await getPosts();
const all = posts.filter((p) => p.id !== post.id);
const byDate = (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
	b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
const sub = subPath(post.data.category);
const top = topCategory(post.data.category);
const sameSub = sub ? all.filter((p) => subPath(p.data.category) === sub).sort(byDate) : [];
const sameTop = all.filter((p) => topCategory(p.data.category) === top && !sameSub.includes(p)).sort(byDate);
const rest = all.filter((p) => !sameSub.includes(p) && !sameTop.includes(p)).sort(byDate);
const relatedPosts = [...sameSub, ...sameTop, ...rest].slice(0, 6);
// 이 글이 속한 토픽 허브(필러) — 글에서 허브로 링크(양방향 클러스터).
const hub = hubForPost(post);
// 10/5: 같은 세부 분류 비교 가이드가 있으면 첫 화면에 링크(상품 글이 네이버 노출의 대부분 — 비교 의도 방문자를 가이드로)
const postCat = String(post.data.category || '');
const guide = (await getGuides()).find((g) => postCat === g.data.category || postCat.startsWith(g.data.category + '>'));
const guideLink = guide ? { href: `/guide/${guide.id}/`, query: guide.data.query, n: guide.data.products.length } : null;
// 같은 분류 가격 비교 — 글마다 고유한 실데이터(가격 순위·중간값·비교표). 요약 문단과 본문 아래 표에 쓴다
const comparison = compareForPost(post, posts);
// FAQ 질문-답 → FAQPage 구조화 데이터 (화면 구조는 remark-faq 가 같은 규칙으로 바꾼다)
const faq = extractFaq(post.body);
// 구글 전용 noindex: 이미 색인된 URL·새 형식 글이 아니면 구글 크롤 대상에서 뺀다(네이버는 그대로)
const googleNoindex = !isGoogleIndexable(new URL(`/blog/${post.id}/`, Astro.site).href, post.body);

// 같은 상품(productId)에 글이 여러 개면 최신 글을 대표로 삼아 canonical을 모은다.
//   재발행으로 234개 상품에 중복 글이 생겼고, 각자 자기를 canonical해 신호가 쪼개져 있었다.
//   canonical만 모으고 페이지는 그대로 둔다(내용이 완전 동일하진 않아 삭제·noindex는 과함).
//   구버전 글 626개는 프론트매터에 productId가 없다. 파일명(cat-productId-YYYYMMDD)에서 복구한다
//   — canonical 묶음에만 쓰고 /go/ 추적링크 동작은 건드리지 않는다.
const pidOf = (p: CollectionEntry<'blog'>): string | undefined =>
	p.data.productId ?? p.id.match(/-(\d{6,})-\d{8}$/)?.[1];

const pid = pidOf(post);
let canonicalPath: string | undefined;
if (pid) {
	const siblings = [post, ...all].filter((p) => pidOf(p) === pid);
	if (siblings.length > 1) {
		// 🔁 2026-10-05 대표 결정: 대표 글 = **가장 먼저 쓴 글**(네이버가 이미 노출해 주는 주소).
		//   전엔 최신 글이었는데, 8/17~ 재발행 글은 노출 0~5% 이고 노출은 첫 글이 받고 있었다(재발행 557글 중 첫 글 노출 70).
		//   astro.config buildNonCanonicalSet·분류/토픽 목록 중복 제거와 같은 규칙으로 맞춘다.
		//   규칙: 네이버 노출 많은 글 → 먼저 쓴 글 → id (src/lib/canonical.ts)
		const primary = siblings.sort(comparePrimary)[0];
		if (primary.id !== post.id) canonicalPath = `/blog/${primary.id}/`;
	}
}
---

<BlogPost {...post.data} guideLink={guideLink} relatedPosts={relatedPosts} hub={hub} comparison={comparison} faq={faq} googleNoindex={googleNoindex} headings={headings} canonicalPath={canonicalPath}>
	<Content />
</BlogPost>
