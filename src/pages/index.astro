---
import { getPosts, getGuides } from '../lib/site';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { categoryList, topicHubs } from '../lib/categories';
import { ORGANIZATION, SITE_DESCRIPTION, SITE_TITLE, SITE_URL } from '../consts';

// GEO: 사이트·조직 엔티티 노드. BlogPosting.publisher 와 같은 @id 로 묶인다.
const websiteLd = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	'@id': `${SITE_URL}/#website`,
	name: SITE_TITLE,
	alternateName: 'shopping-log.com',
	url: `${SITE_URL}/`,
	inLanguage: 'ko',
	publisher: { '@id': ORGANIZATION['@id'] },
};
const orgLd = { '@context': 'https://schema.org', ...ORGANIZATION };

const posts = (await getPosts()).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const recent = posts.slice(0, 12);
const guides = (await getGuides()).slice(0, 8);
const cats = categoryList(posts);
// 토픽 클러스터 허브 — 홈에서 필러(허브)로 직링크해 크롤러가 허브→클러스터 순으로 효율 색인하게 한다.
const hubs = topicHubs(posts, 15).slice(0, 12);

// 2026-09-10: 홈 제목이 사이트명 한 단어(4자)뿐이라 검색결과에서 무엇을 주는 곳인지 안 보였다.
//   브랜드어("쇼핑로그")는 CTR 4.8%로 잘 눌리므로 브랜드는 앞에 두고, 뒤에 실제 제공 가치를 붙인다.
const homeTitle = `${SITE_TITLE} — 상품 추천 ${posts.length.toLocaleString('ko-KR')}개 가격·후기 비교`;
const homeDesc = `${SITE_TITLE}는 네이버 스마트스토어 상품을 가격과 후기, 스펙 기준으로 비교해 정리합니다. 글 ${posts.length.toLocaleString('ko-KR')}개와 주제별 가격 비교 허브 ${topicHubs(posts, 15).length}개를 운영하며, 가격은 확인 시점을 함께 적습니다.`;
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={homeTitle} description={homeDesc} />
		<script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
		<script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
		<style>
			.intro {
				margin-bottom: 2rem;
			}
			.intro h1 {
				margin: 0 0 0.5rem 0;
			}
			.intro p {
				color: rgb(var(--gray));
				margin: 0;
			}
			.recent-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				margin-bottom: 1rem;
			}
			.recent-head a {
				font-size: 0.9rem;
			}
			.categories {
				margin-bottom: 2.5rem;
			}
			.categories h2 {
				margin-bottom: 1rem;
			}
			ul.cat-chips {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-wrap: wrap;
				gap: 0.6rem;
			}
			ul.cat-chips li a {
				display: inline-block;
				padding: 0.5rem 0.9rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 999px;
				text-decoration: none;
				color: rgb(var(--black));
				transition: 0.2s ease;
			}
			ul.cat-chips li a:hover {
				border-color: rgb(var(--accent));
				color: rgb(var(--accent));
			}
			ul.cat-chips .count {
				color: rgb(var(--gray));
				font-size: 0.85em;
			}
			ul.posts {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			ul.posts li {
				padding: 0.6rem 0;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			ul.posts li a {
				display: flex;
				justify-content: space-between;
				gap: 1rem;
				text-decoration: none;
			}
			ul.posts .title {
				color: rgb(var(--black));
			}
			ul.posts .date {
				color: rgb(var(--gray));
				white-space: nowrap;
			}
			ul.posts li a:hover .title {
				color: rgb(var(--accent));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			{guides.length > 0 && (
				<section class="categories">
					<h2>구매 가이드</h2>
					<ul class="cat-chips">{guides.map((g) => <li><a href={`/guide/${g.id}/`}>{g.data.title}</a></li>)}</ul>
				</section>
			)}
			<section class="intro">
				<h1>{SITE_TITLE}</h1>
				<p>{SITE_DESCRIPTION}</p>
			</section>
			<section class="categories">
				<div class="recent-head">
					<h2>카테고리</h2>
					<a href="/category/">전체 보기 →</a>
				</div>
				<ul class="cat-chips">
					{
						cats.map((c) => (
							<li>
								<a href={`/category/${c.slug}/`}>
									{c.name} <span class="count">{c.count}</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>
			<section class="categories">
				<div class="recent-head">
					<h2>주제별 추천 모음</h2>
					<a href="/category/">전체 보기 →</a>
				</div>
				<ul class="cat-chips">
					{
						hubs.map((h) => (
							<li>
								<a href={`/topic/${h.slug}/`}>
									{h.sub} <span class="count">{h.count}</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>
			<section>
				<div class="recent-head">
					<h2>최근 글</h2>
					<a href="/blog/">전체 글 보기 →</a>
				</div>
				<ul class="posts">
					{
						recent.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<span class="title">{post.data.title}</span>
									<span class="date">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
