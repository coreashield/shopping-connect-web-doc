---
// 정책·안내 페이지 레이아웃 (개인정보처리방침·이용약관·문의, 2026-10-15)
//   BlogPost 레이아웃은 Product JSON-LD·구매 카드를 내므로 상품이 아닌 페이지에는 쓰지 않는다.
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	updatedDate: Date;
}
const { title, description, updatedDate } = Astro.props;
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`${title} - ${SITE_TITLE}`} description={description} />
		<style>
			main {
				width: 760px;
				max-width: 100%;
				margin: 0 auto;
				padding: 1.6rem 1.2rem 3rem;
				box-sizing: border-box;
			}
			h1 {
				font-size: clamp(1.6rem, 6vw, 2.2rem);
				margin: 0 0 0.3em;
			}
			.updated {
				color: rgb(var(--gray));
				font-size: 0.9rem;
				margin: 0 0 2em;
			}
			.prose :global(h2) {
				font-size: clamp(1.15rem, 4.8vw, 1.4rem);
				margin-top: 1.8em;
				padding-top: 1em;
				border-top: 1px solid rgba(var(--gray), 0.2);
			}
			.prose :global(p),
			.prose :global(li) {
				line-height: 1.75;
				word-break: keep-all;
			}
			.prose :global(table) {
				width: 100%;
				border-collapse: collapse;
				font-size: 0.92rem;
			}
			.prose :global(th),
			.prose :global(td) {
				border: 1px solid rgba(var(--gray), 0.3);
				padding: 0.5em 0.6em;
				text-align: left;
				vertical-align: top;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>{title}</h1>
			<p class="updated">최종 수정 <FormattedDate date={updatedDate} /></p>
			<div class="prose">
				<slot />
			</div>
		</main>
		<Footer />
	</body>
</html>
