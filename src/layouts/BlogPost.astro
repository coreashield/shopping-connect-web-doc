---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import SeoSchema from '../components/SeoSchema.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { categorySlug, topCategory } from '../lib/categories';
import { AUTHOR_DISPLAY_NAME, SITE_TITLE } from '../consts';
import { keyAnswer } from '../lib/summary';
import type { Comparison } from '../lib/compare';
import type { FaqItem } from '../lib/faq';
import { seoTitle, isLogoImage, isProductPhoto } from '../lib/snippet';
import PricePosition from '../components/PricePosition.astro';
import { type Facts, trustOf, riskOf, reasonsOf, verdictLine, splitWho } from '../lib/facts';

type Props = CollectionEntry<'blog'>['data'] & {
	bodyImage?: string;   // 본문 첫 상품 사진(로고 제외) — 대표 이미지가 판매처 로고일 때 대신 쓴다
	relatedPosts?: CollectionEntry<'blog'>[];
	hub?: { sub: string; slug: string } | null;
	comparison?: Comparison | null;
	faq?: FaqItem[];
	googleNoindex?: boolean;
	noindex?: boolean;
	ads?: boolean;   // AdSense 광고 스크립트 — 상품 글은 false, 소개(about) 페이지는 기본 true
	canonicalPath?: string;
	guideLink?: { href: string; query: string; n: number } | null;   // 10/5 같은 세부 분류 비교 가이드
	facts?: Facts | null;   // 10/21 review101 형식 카드용 상품 사실값(src/data/product_facts.json)
	sections?: { slug: string; title: string; preview: string }[];
	relatedCards?: { href: string; name: string; thumb?: string; score: number | null; price: number | null }[];
};

const { title, description, summary, pubDate, updatedDate, heroImage: heroImageRaw, gallery = [], category, relatedPosts = [], hub = null, comparison = null, faq = [], googleNoindex = false, noindex = false, ads = true, bodyImage,
	canonicalPath, guideLink = null, facts = null, sections = [], relatedCards = [], affiliateUrl, productStore, rating, reviewCount, priceCheckedAt, saleStatus, productId, productName, productPrice, headings = [] } = Astro.props;
const catName = topCategory(category);
// 대표 이미지가 판매처 로고·배너면 본문 첫 상품 사진으로 교체 (og:image·구매 카드 썸네일·상단 이미지 공통)
const heroImage = gallery[0] ?? ((typeof heroImageRaw === 'string' && isLogoImage(heroImageRaw) && bodyImage) ? bodyImage : heroImageRaw);
// GEO: 요약 문단 = 저장된 summary(정의·핵심·장점·대상) + 렌더 시점 가격·평점 문장(productPrice·rating·updatedDate 기준)
//   + 같은 분류 가격 순위 문장(2026-09-28): 판매 페이지에 없는, 이 사이트만 가진 비교 사실
const answer = [keyAnswer(summary, { productPrice, rating, reviewCount, priceCheckedAt, saleStatus, productStore, pubDate, updatedDate }), comparison?.sentence]
	.filter(Boolean).join(' ');
// FAQPage: 본문에 실제로 보이는 질문-답만. 2개 미만이면 넣지 않는다
const faqLd = faq.length >= 2 ? {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
} : null;
const fmtWon = (n: number) => `${n.toLocaleString('ko-KR')}원`;
const discontinued = saleStatus === 'discontinued';

// 목차(ToC): h2/h3만 — 탐색·구글 점프링크·AI 답추출 유리 (CEO 결정 2026-07-06)
const toc = (headings || []).filter((h: any) => h.depth === 2 || h.depth === 3);
// JSON-LD Product: 실데이터만(CEO "실측만·가짜0"). aggregateRating은 실리뷰수 없어 생략, 가격/브랜드만.
const heroSrc = typeof heroImage === 'string' ? heroImage : (heroImage && (heroImage as any).src) || undefined;
const productLd = {
	'@context': 'https://schema.org',
	'@type': 'Product',
	name: productName || title,
	description,
	...(heroSrc ? { image: heroSrc } : {}),
	// 10/5 스키마 진단: productStore 는 브랜드가 아니라 판매처(스토어명) → brand 대신 Offer.seller.
	//   Offer 는 price 가 필수라 가격이 있을 때만 낸다. url 은 제휴 링크가 아니라 이 글 주소.
	...(affiliateUrl && productPrice ? { offers: {
		'@type': 'Offer',
		price: productPrice, priceCurrency: 'KRW',
		url: new URL(Astro.url.pathname, Astro.site).href,
		...(productStore ? { seller: { '@type': 'Organization', name: productStore } } : {}),
		// 가격 갱신 스크립트가 판매처 페이지 삭제를 확인하면 Discontinued (2026-09-08)
		availability: discontinued ? 'https://schema.org/Discontinued' : 'https://schema.org/InStock',
	} } : {}),
};
const catSlug = categorySlug(category);
// 구매 링크를 자체 도메인 /go/ 리다이렉트로 감싸 클릭을 귀속 측정(자율 성장 엔진 E1).
//   productId 없으면(구버전 글) 어필리에이트 링크 직접 사용(무손상).
const buyHref = (affiliateUrl && productId)
	? `/go/${encodeURIComponent(productId)}?u=${encodeURIComponent(affiliateUrl)}`
	: affiliateUrl;
// 10/5: 버튼 위치 측정 — /go/ 링크에만 pos 를 붙인다(제휴 URL u= 는 그대로). functions/go 가 slug#pos 로 기록.
const posHref = (h: string | undefined, pos: string) => (h && h.startsWith('/go/') ? `${h}&pos=${pos}` : h);
// og:image·구매 카드 썸네일: 상품 사진 갤러리 첫 장 → 상품 사진인 대표 이미지 → 본문 첫 상품 사진 (10/21)
const heroStr = typeof heroImage === 'string' ? heroImage : heroImage?.src;
const rawImg = gallery[0] ?? (isProductPhoto(heroStr) ? heroStr : (bodyImage ?? heroStr));
// 10/21 상단 상품 카드(review101 형식): 상품 사진 갤러리 + 가격·평점·버튼을 첫 화면 한 장에
const isProduct = !!(productName || affiliateUrl);
const photos = gallery.length ? gallery : (rawImg ? [rawImg] : []);
const sized = (u: string, w: number) => (/^https:\/\/shop-phinf\.pstatic\.net\//.test(u) ? `${u.replace(/\?.*$/, '')}?type=f${w}_${w}` : u);
// review101 카드 보조값: 사도 되는 이유·해시태그·리뷰 키워드(긍정/주의) — 모두 DB 숫자·판매처 키워드에서
const reasons = facts ? reasonsOf(facts) : [];
const hashtags = facts ? [facts.brand, ...facts.keywords].filter(Boolean).slice(0, 14) : [];
const posKw = facts ? [...facts.attrs.filter((a) => a.pct >= 70).map((a) => a.top), facts.brand, ...facts.keywords].filter(Boolean).slice(0, 6) : [];
const cautionKw = facts ? facts.attrs.filter((a) => a.pct < 70).map((a) => a.label).concat(facts.checks.map((x) => x.split(/[와과(·,]/)[0].trim())).filter((x) => x && x.length <= 14).slice(0, 4) : [];
const leafCat = String(category || '').split('>').map((x) => x.trim()).filter(Boolean).pop();
// 구매 카드(2026-10-03): 첫 화면에 가격·평점·버튼을 한 묶음으로 (네이버 방문→구매버튼 15%, 첫 버튼이 1.8화면 아래였음).
//   평점은 정수(5·4)가 대부분이라 기본값으로 보인다 — 소수점이 있는 실측값만 보여준다(가짜 신뢰 신호 금지).
const shownRating = rating && !Number.isInteger(rating) ? rating : null;
const priceDate = priceCheckedAt || (updatedDate ?? pubDate)?.toISOString?.().slice(0, 10);
const priceDateLabel = priceDate ? `${Number(priceDate.slice(5, 7))}월 ${Number(priceDate.slice(8, 10))}일` : null;
// 같은 분류에서 가격이 아래쪽 절반일 때만 순위를 강조한다(위쪽이면 비교표에서만 보여준다)
const cheapRank = comparison && comparison.rank <= Math.ceil(comparison.groupSize / 2) ? comparison : null;
// 검색 스니펫: 설명 앞에 가격·기준일을 둔다(상품명 검색어에서 클릭 근거). 판매 종료 글은 그대로
const metaDescription = productPrice && !discontinued
	? `${fmtWon(productPrice)}${priceDateLabel ? `(${priceDateLabel} 기준)` : ''}${shownRating ? ` · 평점 ${shownRating.toFixed(1)}` : ''}. ${description}`
	: description;
const imageUrl = rawImg ? new URL(rawImg, Astro.site).href : undefined;
// 검색 결과 제목: 상품명이 뒤쪽에 있는 긴 제목은 상품명 시작 지점부터로 앞당긴다 (본문 H1·JSON-LD headline 은 원래 제목 유지)
const searchTitle = seoTitle({ title, productName });
---

<html lang="ko">
	<head>
		<BaseHead title={searchTitle} description={metaDescription} type="article" imageUrl={imageUrl} canonicalPath={canonicalPath} publishedTime={pubDate} modifiedTime={updatedDate} googleNoindex={googleNoindex} noindex={noindex} ads={ads} />
		<link rel="stylesheet" href="/r101.css?v=2" />
		<SeoSchema
			title={title}
			description={description}
			summary={answer}
			pubDate={pubDate}
			updatedDate={updatedDate}
			catName={catName}
			catSlug={catSlug}
			imageUrl={imageUrl}
		/>
		<style>
			main {
				width: 1120px;
				max-width: 100%;
				margin: 0 auto;
				padding: 1.2rem 1.2rem 3rem;
				box-sizing: border-box;
			}
			.hero-image {
				width: 100%;
			}
			/* 본문 소제목: 전역 h2(2.44em)가 모바일에서 질문형 소제목 한 줄로 화면 절반을 먹었다(10/3) */
			.prose :global(h2) { font-size: clamp(1.3rem, 5.4vw, 1.9rem); line-height: 1.35; word-break: keep-all; margin-top: 1.6em; }
			.prose :global(h3) { font-size: clamp(1.1rem, 4.6vw, 1.45rem); line-height: 1.4; word-break: keep-all; }
			/* 10/3 대표 지시 "강조할 부분은 색·크기, 내용이 바뀌면 줄바꿈": 소제목 위 구분선, 판단 목록 색 상자, 굵게 = 형광펜 */
			.prose :global(h2) { padding-top: 1.1em; border-top: 1px solid rgba(var(--gray), 0.2); }
			.prose :global(p.fit-title) { margin: 1.4em 0 0; padding: 0.7em 1em 0.2em; border-radius: 12px 12px 0 0; font-size: 1.08rem; }
			.prose :global(p.fit-title strong) { background: none; }
			.prose :global(ul.fit-list) { margin: 0 0 1.2em; padding: 0.3em 1em 0.8em 2.1em; border-radius: 0 0 12px 12px; }
			.prose :global(.fit-yes) { background: rgba(3, 199, 90, 0.08); }
			.prose :global(p.fit-yes) { color: #03873d; }
			.prose :global(.fit-no) { background: rgba(232, 121, 12, 0.08); }
			.prose :global(p.fit-no) { color: #b85c00; }
			.prose :global(ul.fit-list li) { margin: 0.35em 0; }
			/* 형광펜은 본문 문단 안 굵게만 — 목록 라벨·고지(인용)까지 칠하면 한 화면에 10곳이 넘어 강조가 사라진다(10/4 실측 12곳) */
			.prose :global(p > strong) { background: linear-gradient(transparent 62%, rgba(255, 214, 0, 0.45) 62%); }
			.prose :global(blockquote p > strong), .prose :global(p.fit-title > strong) { background: none; }
			.guide-link { margin: -.4em 0 1.2em; font-size: .95em; }
			.guide-link a { display: inline-block; background: var(--accent-soft); border: 1px solid #cdebd9; border-radius: 8px; padding: .45em .8em; text-decoration: none; color: var(--accent-dark); font-weight: 600; }
			.hero-image { margin: 0 0 1.4em; }
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
				/* 원본 치수를 프론트매터에 갖고 있지 않아 width/height 속성을 못 준다.
				   정사각 비율 박스로 공간을 미리 확보해 CLS를 막고, contain으로 왜곡은 피한다.
				   (네이버 상품 이미지는 대부분 1:1) */
				aspect-ratio: 1 / 1;
				object-fit: contain;
				max-height: 420px;
				width: auto;
				max-width: 100%;
			}
			.byline {
				margin: 0.4rem 0 0.2rem;
				font-size: 0.9rem;
				color: rgb(var(--gray));
			}
			.byline a {
				color: rgb(var(--gray-dark));
				text-decoration: none;
			}
			.byline a:hover {
				text-decoration: underline;
			}
			/* 2026-10-08 리디자인: 데스크톱은 본문 720px + 오른쪽 고정 구매 카드, 모바일은 DOM 순서 그대로(제목 바로 아래 구매 카드) */
			.prose {
				color: rgb(var(--gray-dark));
				padding: 0;
			}
			/* 2026-10-21 review101 형식: 상단 카드들은 /r101.css, 여기서는 본문 카드만 */
			.prose { min-width: 0; }
			.prose { background: #fff; border: 1px solid #e6e8e3; border-radius: 18px; padding: 0.4rem 1.6rem 1.6rem; }
			@media (max-width: 760px) { .prose { padding: 0.2rem 1rem 1.2rem; border-radius: 14px; } }
			.prose :global(img) { border-radius: 12px; }
			.title {
				margin-bottom: 1em;
				padding: 0.4em 0 0.6em;
				text-align: left;
				line-height: 1.2;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
				/* 모바일에서 55px 제목이 첫 화면을 다 먹었다 */
				font-size: clamp(1.6rem, 5.6vw, 2.5rem);
				font-weight: 900;
				letter-spacing: -0.03em;
				line-height: 1.3;
				word-break: keep-all;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.cat-link {
				color: var(--accent);
				font-family: var(--font-mono);
				font-size: 0.82rem;
				letter-spacing: 0.05em;
				text-decoration: none;
				font-weight: 600;
			}
			.cat-link:hover {
				text-decoration: underline;
			}
			.dot {
				margin: 0 0.4em;
				color: rgb(var(--gray-light));
			}
			.last-updated-on {
				font-style: italic;
			}
			.breadcrumb {
				font-size: 0.85rem;
				color: rgb(var(--gray));
				padding-top: 0.5em;
			}
			.breadcrumb a {
				color: rgb(var(--gray));
				text-decoration: none;
			}
			.breadcrumb a:hover {
				color: var(--accent-dark);
			}
			.buy-cta {
				text-align: center;
				margin: 1.6em auto;
			}
			.buy-card {
				margin: 0 0 1.4em;
				padding: 1.2em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 16px;
				background: #fff;
				box-shadow: var(--box-shadow);
			}
			.buy-card-row { display: flex; gap: 0.9em; align-items: center; margin-bottom: 0.85em; }
			.buy-thumb { width: 84px; height: 84px; flex: 0 0 84px; object-fit: contain; border-radius: 10px; background: #f6f7f9; }
			.buy-info { min-width: 0; }
			.buy-info p { margin: 0; line-height: 1.4; }
			.buy-name { font-size: 0.92rem; color: rgb(var(--gray-dark)); overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
			.buy-price { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: 1.6rem; font-weight: 600; letter-spacing: -0.03em; color: rgb(var(--black)); }
			.buy-price small { font-size: 0.72rem; font-weight: 400; color: rgb(var(--gray)); margin-left: 0.3em; }
			.buy-sub { font-size: 0.82rem; color: rgb(var(--gray)); }
			.buy-rank { font-size: 0.82rem; color: var(--accent); font-weight: 600; }
			.buy-card .buy-note { text-align: center; }
			.buy-risk { color: rgb(var(--gray-dark)); font-weight: 600; }
			.buy-sticky {
				position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
				display: flex; align-items: center; gap: 0.7em;
				padding: 0.6em 1em calc(0.6em + env(safe-area-inset-bottom));
				background: #fff; box-shadow: 0 -2px 12px rgba(var(--black), 12%);
				transform: translateY(110%); transition: transform 0.2s ease;
			}
			.buy-sticky.show { transform: translateY(0); }
			.buy-sticky-price { flex: 1; min-width: 0; font-weight: 800; font-size: 1.05rem; color: #111; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
			.buy-sticky-price small { display: block; font-weight: 400; font-size: 0.7rem; color: rgb(var(--gray)); }
			.buy-sticky a { flex: 0 0 auto; background: var(--accent); color: #fff; font-weight: 700; text-decoration: none; padding: 0.75em 1.1em; border-radius: 10px; }
			@media (min-width: 900px) { .buy-sticky { display: none; } }
			.buy-cta-bottom {
				margin: 2.5em auto 1em;
			}
			.buy-btn {
				display: block;
				width: 100%;
				box-sizing: border-box;
				background: var(--accent);
				color: #fff;
				font-size: 1.15rem;
				font-weight: 700;
				text-decoration: none;
				padding: 0.95em 1.2em;
				border-radius: 12px;
				box-shadow: 0 4px 14px rgba(4, 122, 62, 0.28);
				transition: transform 0.1s ease, box-shadow 0.1s ease;
			}
			.buy-btn:hover {
				transform: translateY(-2px);
				box-shadow: 0 6px 18px rgba(4, 122, 62, 0.36);
				text-decoration: none;
				color: #fff;
			}
			.buy-meta {
				margin: 0 0 0.6em 0;
				color: rgb(var(--gray));
				font-size: 0.95rem;
			}
			.buy-meta span {
				margin: 0 0.45em;
			}
			.buy-rating {
				color: #f5a623;
				font-weight: 700;
			}
			.buy-note {
				margin: 0.55em 0 0 0;
				font-size: 0.8rem;
				color: rgb(var(--gray));
			}
			/* GEO: 정의문+숫자 요약 문단. 페이지 첫 30% 안에 인용 가능한 자기완결 답을 둔다 */
			.compare { margin: 2.2em 0 1em; }
			.compare h2 { margin-bottom: 0.3em; }
			.compare-note { margin: 0 0 0.8em; font-size: 0.85rem; color: rgb(var(--gray)); }
			.compare-wrap { overflow-x: auto; position: relative; }   /* sr-only 칸 제목이 표 밖으로 새어 모바일 가로 스크롤 생기던 것 */
			.compare table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
			.compare th, .compare td { padding: 0.55em 0.5em; border-bottom: 1px solid rgb(var(--gray-light)); text-align: left; vertical-align: top; }
			.compare th { font-size: 0.8rem; color: rgb(var(--gray)); font-weight: 600; white-space: nowrap; }
			.compare td.num { text-align: right; white-space: nowrap; }
			.compare tr.current td { background: var(--accent-soft); font-weight: 600; }
			.compare td a { color: rgb(var(--gray-dark)); }
			.compare td a.alt-buy { display: inline-block; padding: 0.3em 0.6em; border-radius: 6px; background: var(--accent-soft); color: var(--accent-dark); font-weight: 700; text-decoration: none; white-space: nowrap; font-size: 0.82rem; }
			.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
			.sold-out { margin: 0 0 1.4em; padding: 0.8em 1em; border: 1px dashed rgb(var(--gray)); border-radius: 10px; font-size: 0.95rem; }
			.toc {
				margin: 1.5em 0;
				padding: 0.9em 1.2em;
				background: rgba(var(--gray-light), 0.5);
				border: 1px solid rgba(var(--gray), 0.2);
				border-radius: 10px;
				font-size: 0.95rem;
			}
			.toc-title { margin: 0 0 0.5em 0; font-weight: 700; }
			.toc ul { margin: 0; padding-left: 1.1em; }
			.toc li { margin: 0.25em 0; }
			.toc li.toc-sub { margin-left: 0.9em; list-style: circle; font-size: 0.9em; }
			.toc a { color: rgb(var(--gray-dark)); text-decoration: none; }
			.toc a:hover { text-decoration: underline; color: var(--accent, #2337ff); }
		</style>
	</head>

	<body>
		<Header />
		<main>
			<nav class="breadcrumb" aria-label="breadcrumb">
				<a href="/">홈</a>
				<span class="dot">›</span>
				<a href={`/category/${catSlug}/`}>{catName}</a>
				{isProduct && leafCat && leafCat !== catName && <><span class="dot">›</span><span>{leafCat}</span></>}
			</nav>
			{isProduct && (
				<div class="r1">
					<div class="r1-detail-bar"><p>상품 및 리뷰 분석 상세</p><a class="r1-btn r1-btn-light r1-btn-sm" href={`/category/${catSlug}/`}>← 목록으로</a></div>
					<p class="r1-disc-line">* 이 포스팅은 네이버 쇼핑 커넥트 활동의 일환으로, 판매 발생 시 일정액의 수수료를 제공받습니다.</p>
					<section class="r1-kcard r1-pd-hero" aria-label="상품 요약">
						<div class="r1-gal">
							{photos[0] ? (
								<div class="r1-gal-main-wrap"><img class="r1-gal-main" id="pd-main" src={sized(photos[0], 640)} alt={productName || title} width="640" height="640" fetchpriority="high" decoding="async" /><span class="r1-gal-count" id="pd-count">1 / {photos.length}</span></div>
							) : <div class="r1-gal-main-wrap r1-gal-empty">상품 사진</div>}
							{photos.length > 1 && (
								<div class="r1-gal-row">
									{photos.map((u, i) => (
										<button type="button" class:list={['r1-gal-th', 'pd-thumb', { on: i === 0 }]} data-src={sized(u, 640)} data-i={i + 1} aria-label={`사진 ${i + 1}`}>
											<img src={sized(u, 300)} alt="" width="60" height="60" loading="lazy" decoding="async" />
										</button>
									))}
								</div>
							)}
						</div>
						<div class="r1-pd-info">
							<div class="r1-badges">
								<a class="r1-badge r1-badge-primary" href={`/category/${catSlug}/`}>{catName}</a>
								{leafCat && <span class="r1-badge r1-badge-light">{leafCat}</span>}
								{productStore && <span class="r1-badge r1-badge-violet">{productStore}</span>}
								{discontinued ? <span class="r1-badge r1-badge-red">판매 종료</span> : affiliateUrl && <span class="r1-badge r1-badge-green">판매중</span>}
							</div>
							<h1>{title}</h1>
							{productName && productName !== title && <p class="r1-pd-brand">{productName}</p>}
							{leafCat && <p class="r1-pd-kind">{leafCat} 리뷰</p>}
							{facts && <p class="r1-pd-line">{verdictLine(facts.score)}</p>}
							{productPrice && !discontinued ? (
								<p class="r1-pd-price"><strong>{fmtWon(productPrice)}</strong>{facts?.orig && <s>{fmtWon(facts.orig)}</s>}{facts?.discount && <span class="r1-off">{facts.discount}% 할인</span>}{priceDateLabel && <small>{priceDateLabel} 기준</small>}</p>
							) : null}
							{(shownRating || reviewCount || facts?.reviews) && (
								<p class="r1-pd-rate">
									{shownRating && <><span class="r1-stars" aria-hidden="true">★★★★★<span style={`width:${(shownRating / 5) * 100}%`}>★★★★★</span></span><b>{shownRating.toFixed(1)}</b></>}
									<span>({(facts?.reviews ?? reviewCount ?? 0).toLocaleString('ko-KR')}개 리뷰 · 스토어 기준)</span>
								</p>
							)}
							{facts && (
								<div class="r1-conf">
									<div class="r1-conf-score"><small>구매 확신도</small><b>{facts.score}<em>점</em></b></div>
									<div><span class="r1-badge r1-badge-primary">{facts.label}</span><p>리뷰 신뢰도 {trustOf(facts.reviews)} · 리스크 {riskOf(facts.score)}</p></div>
								</div>
							)}
							{cheapRank && !discontinued && <p class="r1-rank">{cheapRank.label} {cheapRank.groupSize}개 중 {cheapRank.rank === 1 ? '가장 저렴' : `${cheapRank.rank}번째로 저렴`}</p>}
							{hashtags.length > 0 && <p class="r1-tags">{hashtags.map((k) => <span>#{k}</span>)}</p>}
							{affiliateUrl && !discontinued ? (
								<>
									<a class="r1-btn r1-btn-primary r1-btn-buy" id="buy-main" href={posHref(buyHref, "card")} target="_blank" rel="nofollow sponsored noopener">할인 적용가 확인하기</a>
									{productPrice && productPrice >= 100000 && <p class="r1-fine">🛡️ 교환·반품 배송비, 설치비, A/S·보증 조건은 판매 페이지 하단 안내에서 주문 전에 확인할 수 있습니다.</p>}
									<p class="r1-fine">가격·배송비·재고는 판매처 표시가 기준입니다. 이 링크로 구매하면 쇼핑로그가 수수료를 받습니다.</p>
								</>
							) : discontinued ? (
								<p class="r1-fine">이 상품은 판매처 페이지가 삭제되어 현재 구매할 수 없습니다. {guideLink ? "아래 비교 가이드나" : "아래"} "함께 보면 좋은 글"에서 같은 주제의 다른 상품을 확인하세요.</p>
							) : null}
							<p class="r1-byline">글 · <a rel="author" href="/about/">{AUTHOR_DISPLAY_NAME}</a> · <FormattedDate date={pubDate} />{updatedDate && <> · 수정 <FormattedDate date={updatedDate} /></>} · <a href="/about/">작성 기준</a></p>
						</div>
					</section>
					{facts && (
						<div class="r1-g2">
							<section class="r1-kcard r1-tint-green">
								<h2 class="r1-kh"><span class="r1-kh-ic r1-ic-green">✓</span>사도 되는 이유</h2>
								<ul class="r1-dots">{reasons.map((x) => <li>{x}</li>)}</ul>
								{affiliateUrl && !discontinued && <a class="r1-btn r1-btn-light r1-btn-sm" href={posHref(buyHref, "reason")} target="_blank" rel="nofollow sponsored noopener">할인 적용가 확인하기</a>}
							</section>
							<section class="r1-kcard r1-tint-orange">
								<h2 class="r1-kh"><span class="r1-kh-ic r1-ic-orange">!</span>구매 전 확인하세요</h2>
								<ul class="r1-dots">{facts.checks.map((x) => <li>{x}</li>)}</ul>
								<p class="r1-mini">{facts.checks.slice(0, 3).map((x) => <span>{x.split(/[와과(·,]/)[0].trim()}</span>)}</p>
							</section>
						</div>
					)}
					{facts && (
						<div class="r1-g3">
							<section class="r1-kcard r1-tint-blue">
								<h2 class="r1-kh"><span class="r1-kh-ic r1-ic-blue">👍</span>이런 분께 추천</h2>
								<ul class="r1-dots">{facts.fit.map((x) => { const [a, b] = splitWho(x); return <li>{a}{b && <small>{b}</small>}</li>; })}</ul>
							</section>
							<section class="r1-kcard r1-tint-red">
								<h2 class="r1-kh"><span class="r1-kh-ic r1-ic-red">✋</span>이런 분은 신중하게</h2>
								<ul class="r1-dots">{facts.unfit.map((x) => { const [a, b] = splitWho(x); return <li>{a}{b && <small>{b}</small>}</li>; })}</ul>
							</section>
							<section class="r1-kcard r1-tint-violet">
								<h2 class="r1-kh"><span class="r1-kh-ic r1-ic-violet">#</span>리뷰 키워드</h2>
								<p class="r1-kw-label r1-kw-pos">긍정</p>
								<p class="r1-kw pos">{posKw.map((k) => <span>{k}</span>)}</p>
								{cautionKw.length > 0 && <><p class="r1-kw-label r1-kw-neg">주의</p><p class="r1-kw neg">{cautionKw.map((k) => <span>{k}</span>)}</p></>}
							</section>
						</div>
					)}
					<div class="r1-g2">
						<section class="r1-kcard">
							<h2 class="r1-kh">가격·배송 체크</h2>
							<dl class="r1-kv">
								{facts?.orig && <div><dt>상품가</dt><dd>{fmtWon(facts.orig)}</dd></div>}
								{productPrice && <div><dt>{facts?.orig ? '할인가' : '판매가'}</dt><dd>{fmtWon(productPrice)}</dd></div>}
								{comparison && <div><dt>같은 분류 중간값</dt><dd>{fmtWon(comparison.median)}</dd></div>}
								<div><dt>배송비·무료배송 기준</dt><dd>스토어 확인</dd></div>
								{priceDate && <div><dt>가격 기준일</dt><dd>{priceDate}</dd></div>}
							</dl>
						</section>
						<section class="r1-kcard">
							<h2 class="r1-kh">스토어 정보</h2>
							<dl class="r1-kv">
								<div><dt>스토어</dt><dd>{productStore || '-'}</dd></div>
								{facts && <div><dt>리뷰 신뢰도</dt><dd>리뷰 신뢰도 {trustOf(facts.reviews)}</dd></div>}
								{(facts?.reviews || reviewCount) && <div><dt>총 리뷰</dt><dd>{(facts?.reviews ?? reviewCount ?? 0).toLocaleString('ko-KR')}개</dd></div>}
								<div><dt>평균 평점</dt><dd>{shownRating ? shownRating.toFixed(1) : '-'}</dd></div>
								<div><dt>판매 상태</dt><dd>{discontinued ? '판매 종료' : '판매중'}</dd></div>
							</dl>
						</section>
					</div>
				</div>
			)}
			<div class:list={[{ 'r1': isProduct, 'r1-detail-cols': isProduct }]}>
				<div>
					{isProduct && (
						<section class="r1-kcard r1-judge">
							<h2 class="r1-kh">리뷰 기반 구매 판단</h2>
							{answer && <a class="r1-jcard r1-jcard-wide" href="#article"><b>📋 {productName || title} 한 줄 정리</b><span>{answer}</span></a>}
							{sections.length > 0 && (
								<div class="r1-jgrid">
									{sections.map((x) => <a class="r1-jcard" href={`#${x.slug}`}><b>{x.title}<i aria-hidden="true">›</i></b><span>{x.preview}</span></a>)}
								</div>
							)}
							{guideLink && <p class="guide-link"><a href={guideLink.href}>{discontinued ? `판매 중인 ${guideLink.query} ${guideLink.n}종 비교 보기 →` : `${guideLink.query} ${guideLink.n}종 비교 보기 →`}</a></p>}
						</section>
					)}
					{isProduct && comparison && productPrice && <PricePosition comparison={comparison} price={productPrice} dateLabel={priceDateLabel} />}
					<article class="prose" id="article">
						{!isProduct && (
							<>
								<div class="title">
									<h1>{title}</h1>
									<div class="byline">
										<span class="by">글 ·</span>
										<a rel="author" href="/about/">{AUTHOR_DISPLAY_NAME}</a>
									</div>
								</div>
								<div class="hero-image">
									{heroImage && (typeof heroImage === 'string'
										? <img src={heroImage} alt={title} loading="lazy" decoding="async" />
										: <Image width={1020} height={510} src={heroImage} alt={title} />)}
								</div>
							</>
						)}
						{/* 상품 글에만 Product 노드. 소개 페이지 등 일반 글에 붙으면 스키마 오류(가짜 상품)가 된다 */}
						{isProduct && <script type="application/ld+json" set:html={JSON.stringify(productLd)} />}
						{faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
						{!isProduct && toc.length >= 3 && (
							<nav class="toc" aria-label="목차">
								<p class="toc-title">📑 목차</p>
								<ul>{toc.map((h: any) => <li class={h.depth === 3 ? 'toc-sub' : ''}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
							</nav>
						)}
						<slot />
						{affiliateUrl && !discontinued && (
							<div class="buy-cta buy-cta-bottom" id="buy-bottom">
								<a class="buy-btn" href={posHref(buyHref, "bottom")} target="_blank" rel="nofollow sponsored noopener">
									네이버에서 현재 가격 보기
								</a>
								<p class="buy-note">이 링크로 구매하면 쇼핑로그가 네이버 쇼핑 커넥트 수수료를 받습니다.</p>
							</div>
						)}
						{/* 10/26: 다른 상품 가격 비교표는 본문·구매 버튼 다음 — 본문보다 먼저 "가격 보기" 5개가 나와 독자가 이 상품을 읽기 전에 다른 상품으로 빠졌다 */}
						{comparison && (
							<section class="compare" aria-labelledby="compare-title">
								<h2 id="compare-title">{comparison.label} 가격 비교</h2>
								<p class="compare-note">
									쇼핑로그가 정리한 {comparison.label} 상품 {comparison.groupSize}개 중 이 상품과 가격대가 가까운 상품입니다.
									가격은 기준일의 판매가이며 현재 가격은 판매처에서 확인하세요.
								</p>
								<div class="compare-wrap">
									<table>
										<thead>
											<tr><th scope="col">상품</th><th scope="col">판매처</th><th scope="col">판매가</th><th scope="col">평점</th><th scope="col">가격 기준일</th><th scope="col"><span class="sr-only">구매</span></th></tr>
										</thead>
										<tbody>
											{comparison.rows.map((r) => (
												<tr class={r.current ? 'current' : ''}>
													<td>{r.current ? <>{r.name} <small>(이 글)</small></> : <a href={`/blog/${r.id}/`}>{r.name}</a>}</td>
													<td>{r.store ?? '-'}</td>
													<td class="num">{fmtWon(r.price)}</td>
													<td class="num">{r.rating ? r.rating.toFixed(1) : '-'}</td>
													<td class="num">{r.checkedAt ?? '-'}</td>
													<td class="num">{r.buyHref ? <a class="alt-buy" href={posHref(r.buyHref, "table")} target="_blank" rel="nofollow sponsored noopener">가격 보기</a> : null}</td>
												</tr>
											))}
										</tbody>
									</table>
								</div>
							</section>
						)}
						{relatedPosts.length > 0 && (
							<aside class="related">
								<h2>함께 보면 좋은 글</h2>
								<ul>{relatedPosts.map((p) => <li><a href={`/blog/${p.id}/`}>{p.data.title}</a></li>)}</ul>
								{hub && <p class="hub-link"><a href={`/topic/${hub.slug}/`}><strong>{hub.sub}</strong> 추천 모음 전체 보기 →</a></p>}
							</aside>
						)}
					</article>
				</div>
				{isProduct && (
					<aside class="r1-side" aria-label="다른 후기 제품과 제품 정보">
						{relatedCards.length > 0 && (
							<section class="r1-kcard r1-side-list">
								<h2>다른 후기 제품 리뷰</h2>
								{relatedCards.map((c) => (
									<a class="r1-oth" href={c.href}>
										{c.thumb ? <img src={sized(c.thumb, 300)} alt="" width="44" height="44" loading="lazy" decoding="async" /> : <i></i>}
										<span><b>{c.name}</b><small>{c.score ? `구매 점수 ${c.score}점` : ''}{c.score && c.price ? ' · ' : ''}{c.price ? fmtWon(c.price) : ''}</small></span>
									</a>
								))}
							</section>
						)}
						{facts && facts.spec.length > 0 && (
							<section class="r1-kcard r1-side-list">
								<h2>제품 상세 정보</h2>
								<dl class="r1-kv">{facts.spec.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
							</section>
						)}
						{affiliateUrl && !discontinued && (
							<a class="r1-btn r1-btn-primary r1-btn-buy" href={posHref(buyHref, "side")} target="_blank" rel="nofollow sponsored noopener">{productPrice ? `${fmtWon(productPrice)} · 현재 가격 보기` : '현재 가격 보기'}</a>
						)}
					</aside>
				)}
			</div>
			{/* 모바일 고정 버튼: 위 카드 버튼이 화면 밖으로 나가면 보이고, 맨 아래 버튼이 보이면 숨는다 */}
			{affiliateUrl && !discontinued && (
				<div class="buy-sticky" id="buy-sticky">
					<span class="buy-sticky-price">{productPrice ? fmtWon(productPrice) : (productName || title)}{priceDateLabel && productPrice && <small>{priceDateLabel} 기준 · 판매처 가격 우선</small>}</span>
					<a href={posHref(buyHref, "sticky")} target="_blank" rel="nofollow sponsored noopener">현재 가격 보기</a>
				</div>
			)}
		</main>
		<Footer />
		<script is:inline>
			(function () {
				var main = document.getElementById('pd-main'), cnt = document.getElementById('pd-count');
				document.querySelectorAll('.pd-thumb').forEach(function (b) {
					b.addEventListener('click', function () {
						if (main) main.src = b.getAttribute('data-src');
						if (cnt) cnt.textContent = b.getAttribute('data-i') + ' / ' + cnt.textContent.split('/')[1].trim();
						document.querySelectorAll('.pd-thumb.on').forEach(function (x) { x.classList.remove('on'); });
						b.classList.add('on');
					});
				});
			})();
			(function () {
				var bar = document.getElementById('buy-sticky'), top = document.getElementById('buy-main'), bottom = document.getElementById('buy-bottom');
				if (!bar || !top || !('IntersectionObserver' in window)) return;
				var pastTop = false, bottomVisible = false;
				var sync = function () { bar.classList.toggle('show', pastTop && !bottomVisible); };
				new IntersectionObserver(function (e) { pastTop = !e[0].isIntersecting && e[0].boundingClientRect.top < 0; sync(); }).observe(top);
				if (bottom) new IntersectionObserver(function (e) { bottomVisible = e[0].isIntersecting; sync(); }).observe(bottom);
			})();
		</script>
	</body>
</html>
