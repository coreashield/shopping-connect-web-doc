---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE } from '../consts';
import { NAVER_SITE_VERIFICATION, GOOGLE_SITE_VERIFICATION, ADSENSE_CLIENT } from '../lib/site';
import { Font } from 'astro:assets';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	// 외부 CDN 절대 URL(상품 사진). 있으면 로컬 플레이스홀더보다 우선한다.
	imageUrl?: string;
	// canonical 경로 override. 같은 상품에 글이 여러 개일 때 최신 글로 신호를 모은다.
	canonicalPath?: string;
	type?: string;
	// article 전용: 검색엔진(네이버·구글) 날짜 인식용 og article 메타 (2026-09-02 네이버 노출 점검)
	publishedTime?: Date;
	modifiedTime?: Date;
	// 색인 제외(2026-09-10). 페이지네이션처럼 검색 가치가 없는데 노출만 먹는 URL에 쓴다.
	//   follow 는 남겨 링크 신호는 개별 글로 계속 흐르게 한다.
	noindex?: boolean;
	googleNoindex?: boolean; // 구글에만 noindex (src/lib/google-index.ts) — 네이버 노출 유지
	// AdSense 광고 스크립트(10/20). 자동 생성 상품 글·여행 상품 페이지는 false — 정책상 자체 콘텐츠가 적은 페이지에 광고 코드를 넣지 않는다.
	//   google-adsense-account 메타(사이트 소유 확인)는 모든 페이지에 남긴다.
	ads?: boolean;
}

const { title, description: rawDescription, image = FallbackImage, imageUrl, canonicalPath, type = 'website', publishedTime, modifiedTime, noindex = false, googleNoindex = false, ads = true } = Astro.props;
// 11/16: 강조 표시용 [HL]…[/HL] 표식이 설명에 남은 글 288개 — 네이버 검색 결과 설명란에 그대로 보였다.
const description = String(rawDescription ?? '').replace(/\[\/?HL\]/g, '').replace(/\s+/g, ' ').trim();
const canonicalURL = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const ogImage = imageUrl ?? new URL(image.src, Astro.url).href;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
{NAVER_SITE_VERIFICATION && <meta name="naver-site-verification" content={NAVER_SITE_VERIFICATION} />}
{GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />}
<!-- 상품 이미지 CDN 핸드셰이크를 조기 시작 → LCP 단축 -->
<link rel="preconnect" href="https://shop-phinf.pstatic.net" crossorigin />
<link rel="dns-prefetch" href="https://shop-phinf.pstatic.net" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<!-- AdSense: 소유 확인 메타는 전 페이지, 광고 스크립트는 ads 인 페이지만 -->
{ADSENSE_CLIENT && <meta name="google-adsense-account" content={ADSENSE_CLIENT} />}
{ADSENSE_CLIENT && ads && <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`} crossorigin="anonymous"></script>}

<Font cssVariable="--font-atkinson" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex, follow" />}
{!noindex && googleNoindex && <meta name="googlebot" content="noindex, follow" />}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<!-- 11/16: 검색 결과 카드의 출처 이름. 없으면 네이버가 "shopping-log.com" 도메인만 보여준다 -->
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
{type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{type === 'article' && (modifiedTime ?? publishedTime) && <meta property="article:modified_time" content={(modifiedTime ?? publishedTime).toISOString()} />}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />

<!-- 10/22 구매 버튼 직접 연결: 사람이 누르는 순간 /go/ 대신 네이버 제휴링크(naver.me)로 바로 보낸다.
     Cloudflare 함수 하루 한도(무료 10만)를 /go/ 가 같이 써서, 한도가 차면 구매 이동이 막히던 문제 대응.
     HTML 에는 /go/ 그대로 둔다 — 크롤러는 robots Disallow /go/ 로 제휴링크를 따라가지 않는다(인위 클릭 방지).
     JS 꺼진 방문자는 기존 /go/ 로 간다. 되돌리려면 이 블록 삭제.
     10/24 클릭 기록 복구: 실제 클릭(click·가운데 클릭) 1번마다 /go/ 로 POST 비콘 1건 — 함수가 GET 과 같은 봇·해외 판정으로
     web_doc_clicks 에 남기고 204. 이동은 기다리지 않는다. 함수 호출은 사람 클릭 수만큼이라 한도에 영향 없음.
     touchstart·mousedown 은 스크롤·누르다 만 것도 잡혀서 주소 교체에만 쓰고, 기록은 click 에서만.
     11/24 STR-02(AI 유입 측정, PM B 조건부 결재·skeptic 조건 5개): 세션 첫 유입처를 sessionStorage sl_src 에 두고 비콘에 s·qk(·rh) 를 덧붙인다.
     네트워크 요청·함수 호출은 늘지 않는다(기존 비콘 URL 에 값만). 검색어 등 쿼리 값은 안 남기고 키 이름(qk)만, 유입 호스트(rh)는 s=other 일 때만.
     direct 대신 noref("referer 없음" — 직접·앱·utm 빠진 ChatGPT 가 섞임). review_site/lib/render.js 에 같은 분류가 있다(바꾸면 둘 다). -->
<script is:inline>
(function () {
	var src = (function () {
		var u = '', h = '', qk = [], cur, v = null;
		try { var q = new URLSearchParams(location.search); u = (q.get('utm_source') || '').toLowerCase(); q.forEach(function (_, k) { if (qk.length < 5) qk.push(k.toLowerCase().replace(/[^a-z0-9_.-]/g, '').slice(0, 20)); }); } catch (e) {}
		try { h = document.referrer ? new URL(document.referrer).hostname.toLowerCase() : ''; } catch (e) {}
		var s = /chatgpt/.test(u) || /(^|\.)(chatgpt\.com|openai\.com)$/.test(h) ? 'chatgpt'
			: /perplexity/.test(u) || /(^|\.)perplexity\.ai$/.test(h) ? 'perplexity'
			: /gemini/.test(u) || h === 'gemini.google.com' ? 'gemini'
			: /claude/.test(u) || /(^|\.)claude\.ai$/.test(h) ? 'claude'
			: /copilot|bing/.test(u) || /(^|\.)(bing\.com|copilot\.microsoft\.com)$/.test(h) ? 'copilot'
			: !h ? 'noref' : /(^|\.)shopping-log\.com$/.test(h) ? 'internal'
			: h === 'm.search.naver.com' ? 'naver_m' : h === 'search.naver.com' ? 'naver_pc' : /(^|\.)naver\.com$/.test(h) ? 'naver_etc'
			: /(^|\.)google\.[a-z.]+$/.test(h) ? 'google' : /(^|\.)daum\.net$/.test(h) ? 'daum' : 'other';
		cur = { s: s, q: qk.join(','), h: s === 'other' ? h.slice(0, 60) : '' };
		try { v = JSON.parse(sessionStorage.getItem('sl_src') || 'null'); } catch (e) {}
		// 세션 첫 페이지 값 유지. 같은 탭에서 바깥 유입처로 새로 들어오면(internal·noref 아님) 그 값으로 바꾼다.
		if (!v || !v.s || (s !== 'internal' && s !== 'noref')) { v = cur; try { sessionStorage.setItem('sl_src', JSON.stringify(v)); } catch (e) {} }
		return v;
	})();
	function link(e) {
		var a = e.target && e.target.closest && e.target.closest('a[data-go], a[href*="/go/"]');
		if (!a) return null;
		try {
			var url = new URL(a.getAttribute('data-go') || a.href, location.href);
			if (url.origin !== location.origin || url.pathname.indexOf('/go/') !== 0) return null;
			return { a: a, url: url };
		} catch (err) { return null; }
	}
	function direct(e) {
		var l = link(e);
		if (!l || l.a.hasAttribute('data-go')) return;
		var u = l.url.searchParams.get('u');
		if (u && /^https:\/\/naver\.me\/[A-Za-z0-9]+$/.test(u)) { l.a.setAttribute('data-go', l.url.href); l.a.href = u; }
	}
	var last = 0;
	function record(e) {
		direct(e);
		var l = link(e);
		if (!l || !navigator.sendBeacon) return;
		var now = Date.now();
		if (now - last < 800) return;   // 같은 누름이 click·auxclick 으로 두 번 오는 경우
		last = now;
		try {
			var b = new URL(l.url.href);
			b.searchParams.set('p', location.pathname);
			if (src && src.s) b.searchParams.set('s', src.s);
			if (src && src.q) b.searchParams.set('qk', src.q);
			if (src && src.h) b.searchParams.set('rh', src.h);
			navigator.sendBeacon(b.pathname + b.search);
		} catch (err) {}
	}
	document.addEventListener('mousedown', direct, true);
	document.addEventListener('touchstart', direct, { capture: true, passive: true });
	document.addEventListener('keydown', function (e) { if (e.key === 'Enter') direct(e); }, true);
	document.addEventListener('click', record, true);
	document.addEventListener('auxclick', function (e) { if (e.button === 1) record(e); }, true);
})();
</script>
