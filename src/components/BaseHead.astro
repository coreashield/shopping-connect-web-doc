---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE } from '../consts';
import { NAVER_SITE_VERIFICATION, GOOGLE_SITE_VERIFICATION, ADSENSE_CLIENT } from '../lib/site';
import { Font } from 'astro:assets';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	// 외부 CDN 절대 URL(상품 사진). 있으면 로컬 플레이스홀더보다 우선한다.
	imageUrl?: string;
	// canonical 경로 override. 같은 상품에 글이 여러 개일 때 최신 글로 신호를 모은다.
	canonicalPath?: string;
	type?: string;
	// article 전용: 검색엔진(네이버·구글) 날짜 인식용 og article 메타 (2026-09-02 네이버 노출 점검)
	publishedTime?: Date;
	modifiedTime?: Date;
	// 색인 제외(2026-09-10). 페이지네이션처럼 검색 가치가 없는데 노출만 먹는 URL에 쓴다.
	//   follow 는 남겨 링크 신호는 개별 글로 계속 흐르게 한다.
	noindex?: boolean;
	googleNoindex?: boolean; // 구글에만 noindex (src/lib/google-index.ts) — 네이버 노출 유지
	// AdSense 광고 스크립트(10/20). 자동 생성 상품 글·여행 상품 페이지는 false — 정책상 자체 콘텐츠가 적은 페이지에 광고 코드를 넣지 않는다.
	//   google-adsense-account 메타(사이트 소유 확인)는 모든 페이지에 남긴다.
	ads?: boolean;
}

const { title, description, image = FallbackImage, imageUrl, canonicalPath, type = 'website', publishedTime, modifiedTime, noindex = false, googleNoindex = false, ads = true } = Astro.props;
const canonicalURL = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const ogImage = imageUrl ?? new URL(image.src, Astro.url).href;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
{NAVER_SITE_VERIFICATION && <meta name="naver-site-verification" content={NAVER_SITE_VERIFICATION} />}
{GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />}
<!-- 상품 이미지 CDN 핸드셰이크를 조기 시작 → LCP 단축 -->
<link rel="preconnect" href="https://shop-phinf.pstatic.net" crossorigin />
<link rel="dns-prefetch" href="https://shop-phinf.pstatic.net" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<!-- AdSense: 소유 확인 메타는 전 페이지, 광고 스크립트는 ads 인 페이지만 -->
{ADSENSE_CLIENT && <meta name="google-adsense-account" content={ADSENSE_CLIENT} />}
{ADSENSE_CLIENT && ads && <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`} crossorigin="anonymous"></script>}

<Font cssVariable="--font-atkinson" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex, follow" />}
{!noindex && googleNoindex && <meta name="googlebot" content="noindex, follow" />}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
{type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{type === 'article' && (modifiedTime ?? publishedTime) && <meta property="article:modified_time" content={(modifiedTime ?? publishedTime).toISOString()} />}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />
