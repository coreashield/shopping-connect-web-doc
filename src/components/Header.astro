---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import { SITE_CATEGORY } from '../lib/site';
// 여행 섹션은 본체 사이트에만 있다(서브도메인은 카테고리 전용).
const showTravel = !SITE_CATEGORY;
---

<header>
	<nav aria-label="주요 메뉴">
		<h2>
			<a href="/" class="brand">
				<svg width="24" height="24" viewBox="0 0 26 26" aria-hidden="true"><rect x="2" y="18" width="10" height="4" rx="2" fill="rgb(var(--black))"/><rect x="2" y="11" width="16" height="4" rx="2" fill="rgb(var(--black))"/><rect x="2" y="4" width="22" height="4" rx="2" fill="var(--accent)"/></svg>
				<span>{SITE_TITLE}</span>
			</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/">홈</HeaderLink>
			<HeaderLink href="/blog">전체 글</HeaderLink>
			<HeaderLink href="/category">카테고리</HeaderLink>
			<HeaderLink href="/guide">구매 가이드</HeaderLink>
			{showTravel && <HeaderLink href="/travel">여행</HeaderLink>}
			<HeaderLink href="/about">소개</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1.2em;
		background: #fff;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	nav {
		max-width: 1120px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5em 1.5em;
		padding: 0.7em 0;
	}
	h2 {
		margin: 0;
		font-size: 1em;
		white-space: nowrap;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55em;
		font-size: 1.3rem;
		font-weight: 900;
		letter-spacing: -0.02em;
		color: rgb(var(--black));
		text-decoration: none;
	}
	.internal-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.15em 0.3em;
		font-size: 0.92rem;
		font-weight: 500;
	}
	nav .internal-links a {
		padding: 0.55em 0.85em;
		border-radius: 8px;
		color: rgb(var(--black));
		text-decoration: none;
	}
	nav .internal-links a:hover {
		background: rgba(var(--gray-light), 0.5);
	}
	nav .internal-links a.active {
		background: var(--accent-soft);
		color: var(--accent-dark);
		font-weight: 700;
		text-decoration: none;
	}
	/* 모바일: 로고가 두 줄로 깨지고 메뉴가 줄바꿈돼 헤더가 첫 화면 1/6을 먹었다(10/3) → 메뉴는 한 줄 가로 스크롤 */
	@media (max-width: 720px) {
		header { padding: 0 0.7em; }
		nav { flex-wrap: wrap; padding: 0.5em 0 0.3em; }
		.internal-links { flex-wrap: nowrap; width: 100%; overflow-x: auto; white-space: nowrap; scrollbar-width: none; }
		nav .internal-links a { padding: 0.7em 0.7em; min-height: 44px; box-sizing: border-box; display: inline-flex; align-items: center; }
	}
</style>
