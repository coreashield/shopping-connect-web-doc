---
// 서버 렌더 JSON-LD (BlogPosting + BreadcrumbList).
// ⚠️ Review/AggregateRating(스타 평점)은 직접 리뷰한 제품이 아니므로 넣지 않음
//    (정책 위반 → 리치결과 자격 박탈·수동조치 위험. 2026 리서치 근거).
// GEO(2026-09-07): author 를 consts 의 AUTHOR_NODE(Person 또는 편집팀 Organization)로,
//    publisher 를 @id 가 있는 ORGANIZATION 노드로 통일해 사이트 전역에서 같은 엔티티를 가리키게 한다.
//    summary 는 abstract 로 실어 AI 답변 엔진이 본문을 읽기 전에 요약을 얻게 한다.
import { AUTHOR_NODE, ORGANIZATION } from '../consts';

interface Props {
	title: string;
	description: string;
	summary?: string;
	pubDate: Date;
	updatedDate?: Date;
	catName?: string;
	catSlug?: string;
	imageUrl?: string;
}

const { title, description, summary, pubDate, updatedDate, catName, catSlug, imageUrl } = Astro.props;
const siteBase = (Astro.site?.href || 'https://shopping-log.com/').replace(/\/$/, '');
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

const breadcrumb: Record<string, unknown> = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: '홈', item: `${siteBase}/` },
		...(catName && catSlug
			? [{ '@type': 'ListItem', position: 2, name: catName, item: `${siteBase}/category/${catSlug}/` }]
			: []),
		{ '@type': 'ListItem', position: catName ? 3 : 2, name: title, item: pageUrl },
	],
};

const article: Record<string, unknown> = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title.slice(0, 110),
	description,
	...(summary ? { abstract: summary } : {}),
	inLanguage: 'ko',
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
	author: AUTHOR_NODE,
	publisher: ORGANIZATION,
	...(imageUrl ? { image: [imageUrl] } : {}),
};
---

<script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
<script type="application/ld+json" set:html={JSON.stringify(article)} />
