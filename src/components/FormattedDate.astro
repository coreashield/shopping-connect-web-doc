---
interface Props {
	date: Date;
}

const { date } = Astro.props;
---

<time datetime={date.toISOString()}>
	{
		// 한국어 페이지에 영문 날짜("Sep 27, 2026")가 섞여 있던 것을 한국어로 (2026-09-28)
		date.toLocaleDateString('ko-KR', {
			year: 'numeric',
			month: 'long',
			day: 'numeric',
			timeZone: 'Asia/Seoul',
		})
	}
</time>
